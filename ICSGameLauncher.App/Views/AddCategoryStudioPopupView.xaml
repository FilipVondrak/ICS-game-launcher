<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:ICSGameLauncher.App.ViewModels"
             x:DataType="viewModels:AddCategoryStudioPopupViewModel"
             x:Class="ICSGameLauncher.App.Views.AddCategoryStudioPopupView">
    <Border StrokeShape="RoundRectangle 15"
            Padding="15"
            BackgroundColor="{AppThemeBinding Light=White, Dark=#222222}"
            VerticalOptions="Center"
            HorizontalOptions="Center">
        <VerticalStackLayout Spacing="15" WidthRequest="400">
            <Label Text="{Binding Title}"
                   Style="{StaticResource SubHeadline}"
                   HorizontalOptions="Start" />

            <Border StrokeShape="RoundRectangle 8"
                    StrokeThickness="1">
                <Entry Placeholder="Enter name..."
                       Text="{Binding InputtedName}"
                       Margin="10,0" />
            </Border>

            <HorizontalStackLayout Spacing="15" HorizontalOptions="End" Margin="0,10,0,0">
                <Button Text="Cancel"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light=Black, Dark=White}"
                        BorderColor="Gray"
                        BorderWidth="1"
                        WidthRequest="100"/>

                <Button Text="Save"
                        Command="{Binding SaveCommand}"
                        WidthRequest="120" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>