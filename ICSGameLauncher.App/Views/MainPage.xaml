<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:ICSGameLauncher.App.ViewModels"
             x:DataType="viewmodels:MainPageViewModel"
             x:Class="ICSGameLauncher.App.Views.MainPage">

    <Grid ColumnDefinitions="220, *" RowDefinitions="80, *" ColumnSpacing="0" Padding="16">

        <VerticalStackLayout ZIndex="2" Margin="0,35,0,0" Grid.RowSpan="2"
                             InputTransparent="True"
                             CascadeInputTransparent="False">
            <HorizontalStackLayout HorizontalOptions="Start"
                                   VerticalOptions="Center"
                                   Spacing="10"
                                   Margin="30,0,0,0">
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ShowUserOptionsCommand}" />
                </HorizontalStackLayout.GestureRecognizers>
                <Ellipse WidthRequest="40" HeightRequest="40" Fill="LightGray" />
                <Label Text="{Binding LoggedInUserName}" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Border x:Name="DropdownMenu"
                    IsVisible="{Binding IsProfileMenuVisible}"
                    Opacity="0"
                    TranslationY="-20"
                    Margin="0,10,0,0"
                    Padding="15"
                    WidthRequest="200"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#222}"
                    StrokeShape="RoundRectangle 12"
                    HorizontalOptions="End"
                    ZIndex="100">

                <VerticalStackLayout Spacing="10">
                    <Button Text="Edit profile" Command="{Binding EditProfileCommand}" />
                    <Button Text="Switch user" Command="{Binding LogoutCommand}" />
                    <Button Text="Delete profile" Command="{Binding DeleteProfileCommand}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>


        <!-- Left sidebar -->
        <VerticalStackLayout Grid.Column="0" Grid.Row="1" Padding="15" Spacing="15" ZIndex="1">
            <Button Text="Store" Command="{Binding SwitchViewCommand}" CommandParameter="Store" Padding="15" />
            <Button Text="Library" Command="{Binding SwitchViewCommand}" CommandParameter="Library" Padding="15" />
        </VerticalStackLayout>

        <!-- Dynamic Content Area -->
        <ContentView Grid.Column="1" Content="{Binding CurrentContent}" Padding="15" Grid.RowSpan="2" Grid.Row="0" />

    </Grid>

</ContentPage>