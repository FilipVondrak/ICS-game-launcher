<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:ICSGameLauncher.App.Views"
             xmlns:dto="clr-namespace:ICSGameLauncher.BL.DTO;assembly=ICSGameLauncher.BL"
             xmlns:converters="clr-namespace:ICSGameLauncher.App.Converters"
             xmlns:components="clr-namespace:ICSGameLauncher.App.Views.Components"
             x:Class="ICSGameLauncher.App.Views.StoreView"
             x:Name="RootStoreView"
             xmlns:vm="clr-namespace:ICSGameLauncher.App.ViewModels"
             x:DataType="vm:StoreViewModel">

    <ContentView.Resources>
        <converters:PegiToAgeConverter x:Key="PegiConverter" />
    </ContentView.Resources>

    <Grid RowDefinitions="80,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,*,Auto">
            <views:IcsSearchBar Grid.Column="0" Grid.ColumnSpan="2" />

            <HorizontalStackLayout Grid.Column="2"
                                   Spacing="8"
                                   Margin="24,0,0,0"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Center">
                <Button x:Name="FilterButton"
                        Text="&#9776;"
                        WidthRequest="56"
                        HeightRequest="48"
                        CornerRadius="8"
                        Command="{Binding ToggleFilterPopupCommand}"
                        CommandParameter="{Binding BindingContext, Source={x:Reference FilterPopup}}" />

                <Button x:Name="SortButton"
                        Text="&#8645;"
                        WidthRequest="56"
                        HeightRequest="48"
                        CornerRadius="8"
                        Command="{Binding ToggleSortPopupCommand}" />

                <Button Text="Add game"
                        Command="{Binding AddGameCommand}"/>
            </HorizontalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1" VerticalOptions="Fill">
            <FlexLayout BindableLayout.ItemsSource="{Binding Titles}"
                        Wrap="Wrap"
                        Direction="Row"
                        JustifyContent="Center"
                        AlignItems="Start">

                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="dto:TitleDto">

                        <ContentView WidthRequest="220" HeightRequest="350" Margin="10">

                            <components:TitleCardView
                                TitleName="{Binding Name}"
                                AgeRating="{Binding PegiRating, Converter={StaticResource PegiConverter}}"
                                Description="{Binding Description}"
                                IsInStore="True"
                                DetailsCommand="{Binding BindingContext.ShowGameDetailsCommand, Source={x:Reference RootStoreView}}"
                                AddToCommand="{Binding BindingContext.AddGameToLibraryCommand, Source={x:Reference RootStoreView}}" />

                        </ContentView>

                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </ScrollView>

        <Grid Grid.Row="0"
              Grid.RowSpan="2"
              InputTransparent="True"
              CascadeInputTransparent="False"
              ZIndex="100">
            <views:FilterPopupView x:Name="FilterPopup"
                                   IsVisible="{Binding BindingContext.IsFilterPopupVisible, Source={x:Reference RootStoreView}}"
                                   InputTransparent="False"
                                   Margin="0,60,70,0"
                                   HorizontalOptions="End"
                                   VerticalOptions="Start" />

            <Border x:Name="SortPopup"
                    IsVisible="{Binding IsSortPopupVisible}"
                    InputTransparent="False"
                    Margin="0,60,120,0"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    WidthRequest="320"
                    MaximumWidthRequest="340"
                    Padding="12"
                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10"
                                     Padding="0,0,0,8">
                    <Label Text="Sort by:"
                           FontSize="22"
                           HorizontalOptions="Center" />

                    <VerticalStackLayout Spacing="4">
                        <HorizontalStackLayout Spacing="0">
                            <CheckBox x:Name="SortByNameCheckBox"
                                      IsChecked="{Binding SortByName}" />
                            <Label Text="Name"
                                   VerticalOptions="Center"
                                   Margin="-6,0,0,0" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="0">
                            <CheckBox x:Name="SortByStudioCheckBox"
                                      IsChecked="{Binding SortByStudio}" />
                            <Label Text="Studio"
                                   VerticalOptions="Center"
                                   Margin="-6,0,0,0" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="0">
                            <CheckBox x:Name="SortByPegiCheckBox"
                                      IsChecked="{Binding SortByPegi}" />
                            <Label Text="PEGI rating"
                                   VerticalOptions="Center"
                                   Margin="-6,0,0,0" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="0">
                            <CheckBox x:Name="SortByCategoryCheckBox"
                                      IsChecked="{Binding SortByCategory}" />
                            <Label Text="Category"
                                   VerticalOptions="Center"
                                   Margin="-6,0,0,0" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Margin="0,6,0,0" />

                    <Label Text="Direction:"
                           FontSize="18"
                           HorizontalOptions="Center" />

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="8">
                        <Button Grid.Column="0"
                                x:Name="SortAscendingButton"
                                Text="Ascending (A-Z)"
                                Opacity="{Binding SortAscendingOpacity}"
                                Command="{Binding SetSortDirectionCommand}"
                                CommandParameter="{x:Boolean True}" />
                        <Button Grid.Column="1"
                                x:Name="SortDescendingButton"
                                Text="Descending (Z-A)"
                                Opacity="{Binding SortDescendingOpacity}"
                                Command="{Binding SetSortDirectionCommand}"
                                CommandParameter="{x:Boolean False}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentView>
