<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:ICSGameLauncher.App.Views"
             x:Class="ICSGameLauncher.App.Views.StoreView">
    <Grid RowDefinitions="80,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,*,*">
            <views:IcsSearchBar Grid.Column="0" Grid.ColumnSpan="2" />

            <HorizontalStackLayout Grid.Column="2"
                                   Spacing="8"
                                   Margin="24,0,0,0"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Center">
                <Button x:Name="FilterButton"
                        Text="&#9776;"
                        WidthRequest="56"
                        HeightRequest="48"
                        CornerRadius="8"
                        Clicked="OnFilterButtonClicked" />
            </HorizontalStackLayout>
        </Grid>

        <Border Grid.Row="1" BackgroundColor="Chartreuse">
            <Grid Padding="20" />
        </Border>

        <Grid Grid.Row="0"
              Grid.RowSpan="2"
              InputTransparent="True"
              CascadeInputTransparent="False"
              ZIndex="100">
            <views:FilterPopupView x:Name="FilterPopup"
                                   IsVisible="False"
                                   InputTransparent="False"
                                   Margin="0"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Start" />
        </Grid>
    </Grid>
</ContentView>
