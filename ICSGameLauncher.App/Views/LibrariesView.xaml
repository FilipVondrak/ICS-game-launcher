<?xml version="1.0" encoding="utf-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dto="clr-namespace:ICSGameLauncher.BL.DTO;assembly=ICSGameLauncher.BL"
             xmlns:views="clr-namespace:ICSGameLauncher.App.Views"
             xmlns:vm="clr-namespace:ICSGameLauncher.App.ViewModels"
             x:Class="ICSGameLauncher.App.Views.LibrariesView"
             x:DataType="vm:LibrariesViewModel"
             x:Name="LibraryViewRoot">
    <Grid>
        <Grid RowDefinitions="80,Auto,*"
              RowSpacing="20">
            <Grid Grid.Row="0"
                  ColumnDefinitions="*,Auto,Auto,Auto"
                  ColumnSpacing="8">
                <views:IcsSearchBar Grid.Column="0" />

                <Button Grid.Column="1"
                        x:Name="FilterButton"
                        Text="&#9776;"
                        WidthRequest="56"
                        HeightRequest="48"
                        CornerRadius="8"
                        VerticalOptions="Center"
                        Command="{Binding ToggleFilterPopupCommand}" />

                <Button Grid.Column="2"
                        Text="&#8645;"
                        WidthRequest="56"
                        HeightRequest="48"
                        CornerRadius="8"
                        VerticalOptions="Center"
                        Command="{Binding Source={x:Reference LibraryViewRoot}, Path=BindingContext.ToggleSortPopupCommand}" />

                <Button Grid.Column="3"
                        Text="+ Add Library"
                        WidthRequest="132"
                        HeightRequest="48"
                        CornerRadius="8"
                        VerticalOptions="Center"
                        Command="{Binding Source={x:Reference LibraryViewRoot}, Path=BindingContext.OpenCreateLibraryCommand}" />
            </Grid>

            <Label Grid.Row="1"
                   Text="Libraries"
                   FontSize="24" />

            <ScrollView Grid.Row="2">
                <FlexLayout BindableLayout.ItemsSource="{Binding Libraries}"
                            Direction="Row"
                            Wrap="Wrap"
                            JustifyContent="Start"
                            AlignItems="Start"
                            AlignContent="Start"
                            HorizontalOptions="Center"
                            MaximumWidthRequest="1080">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="dto:LibraryDto">
                            <Border Padding="12"
                                    Margin="8"
                                    WidthRequest="300"
                                    MinimumHeightRequest="210">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <Grid RowDefinitions="*,Auto"
                                      RowSpacing="16">
                                    <Border Grid.Row="0"
                                            Padding="12"
                                            MinimumHeightRequest="110"
                                            MinimumWidthRequest="180"
                                            MaximumWidthRequest="220"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            BackgroundColor="Transparent">

                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={x:Reference LibraryViewRoot}, Path=BindingContext.OpenLibraryCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>

                                        <VerticalStackLayout HorizontalOptions="Center"
                                                             VerticalOptions="Center"
                                                             Spacing="8">
                                            <Label Text="{Binding Description}"
                                                   FontSize="22"
                                                   HorizontalTextAlignment="Center"
                                                   LineBreakMode="TailTruncation" />

                                            <Label Text="{Binding TitleCount, StringFormat='{}{0} titles'}"
                                                   FontSize="13"
                                                   HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </Border>

                                    <Grid Grid.Row="1"
                                          ColumnDefinitions="*,*"
                                          ColumnSpacing="20">
                                        <Button Grid.Column="0"
                                                Text="Delete"
                                                HeightRequest="44"
                                                CornerRadius="5"
                                                Command="{Binding Source={x:Reference LibraryViewRoot}, Path=BindingContext.DeleteLibraryCommand}"
                                                CommandParameter="{Binding Id}" />

                                        <Button Grid.Column="1"
                                                Text="Edit"
                                                HeightRequest="44"
                                                CornerRadius="5"
                                                Command="{Binding Source={x:Reference LibraryViewRoot}, Path=BindingContext.EditLibraryCommand}"
                                                CommandParameter="{Binding Id}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </ScrollView>
        </Grid>

        <Grid IsVisible="{Binding IsSortPopupVisible}"
              InputTransparent="True"
              CascadeInputTransparent="False">
            <Grid RowDefinitions="80,*"
                  ColumnDefinitions="*,Auto,Auto,Auto"
                  ColumnSpacing="8">
                <Border Grid.Row="1"
                        Grid.Column="2"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        Margin="0,8,0,0"
                        WidthRequest="280"
                        MaximumWidthRequest="300"
                        Padding="12"
                        InputTransparent="False"
                        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <ScrollView>
                        <VerticalStackLayout Spacing="10"
                                             Padding="0,0,0,8">
                            <Label Text="Sort"
                                   FontSize="22"
                                   HorizontalOptions="Center" />

                            <Label Text="Alphabetical"
                                   FontSize="18" />

                            <VerticalStackLayout Spacing="4">
                                <HorizontalStackLayout Spacing="0">
                                    <CheckBox IsChecked="{Binding SortAlphabetAsc}" />
                                    <Label Text="A-Z"
                                           VerticalOptions="Center"
                                           Margin="-6,0,0,0" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="0">
                                    <CheckBox IsChecked="{Binding SortAlphabetDesc}" />
                                    <Label Text="Z-A"
                                           VerticalOptions="Center"
                                           Margin="-6,0,0,0" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <Label Text="Titles count"
                                   FontSize="18" />
                            <VerticalStackLayout Spacing="4">
                                <HorizontalStackLayout Spacing="0">
                                    <CheckBox IsChecked="{Binding SortTitlesAsc}" />
                                    <Label Text="Low to High"
                                           VerticalOptions="Center"
                                           Margin="-6,0,0,0" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="0">
                                    <CheckBox IsChecked="{Binding SortTitlesDesc}" />
                                    <Label Text="High to Low"
                                           VerticalOptions="Center"
                                           Margin="-6,0,0,0" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,6,0,0">
                                <Button Grid.Column="1"
                                        Text="Clear"
                                        Command="{Binding ClearSortCommand}" />
                                <Button Grid.Column="2"
                                        Text="Apply"
                                        Command="{Binding ApplySortCommand}" />
                            </Grid>
                        </VerticalStackLayout>
                    </ScrollView>
                </Border>
            </Grid>
        </Grid>

        <Grid IsVisible="{Binding IsFilterPopupVisible}"
              InputTransparent="True"
              CascadeInputTransparent="False">
            <Border HorizontalOptions="End"
                    VerticalOptions="Start"
                    Margin="0,60,196,0"
                    Padding="12"
                    InputTransparent="False"
                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

                <HorizontalStackLayout Spacing="0">
                    <CheckBox IsChecked="{Binding HideEmptyLibraries}" />
                    <Label Text="Hide empty"
                           VerticalOptions="Center"
                           Margin="-6,0,0,0" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <Grid IsVisible="{Binding IsCreatePopupVisible}"
              InputTransparent="False">
            <Border HorizontalOptions="Fill"
                    VerticalOptions="Center"
                    Margin="16"
                    MaximumWidthRequest="560"
                    Padding="16"
                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

                <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                      RowSpacing="14">
                    <Label Grid.Row="0"
                           Text="Create Library"
                           FontSize="22"
                           HorizontalOptions="Center" />

                    <Grid Grid.Row="1"
                          ColumnDefinitions="Auto,*"
                          ColumnSpacing="12">
                        <Label Grid.Column="0"
                               Text="Library Name:"
                               VerticalOptions="Center" />
                        <Entry Grid.Column="1"
                               Text="{Binding NewLibraryName}" />
                    </Grid>

                    <Label Grid.Row="2"
                           Text="Library name is required!"
                           IsVisible="{Binding IsCreateNameValidationVisible}"
                           TextColor="Red"
                           FontSize="12" />

                    <Grid Grid.Row="3"
                          ColumnDefinitions="*,Auto,Auto"
                          ColumnSpacing="12">
                        <Button Grid.Column="1"
                                Text="Cancel"
                                Command="{Binding Source={x:Reference LibraryViewRoot}, Path=BindingContext.CancelCreateLibraryCommand}" />
                        <Button Grid.Column="2"
                                Text="Confirm"
                                Command="{Binding Source={x:Reference LibraryViewRoot}, Path=BindingContext.ConfirmCreateLibraryCommand}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid IsVisible="{Binding IsEditPopupVisible}"
              InputTransparent="False">
            <Border HorizontalOptions="Fill"
                    VerticalOptions="Start"
                    Margin="20,120,20,0"
                    MaximumWidthRequest="720"
                    Padding="16"
                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

                <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                      RowSpacing="14">
                    <Label Grid.Row="0"
                           Text="Edit Library"
                           FontSize="22"
                           HorizontalOptions="Center" />

                    <Grid Grid.Row="1"
                          ColumnDefinitions="Auto,*"
                          ColumnSpacing="12">
                        <Label Grid.Column="0"
                               Text="Library Name:"
                               VerticalOptions="Center" />
                        <Entry Grid.Column="1"
                               Text="{Binding EditedLibraryName}" />
                    </Grid>

                    <Label Grid.Row="2"
                           Text="Library name is required!"
                           IsVisible="{Binding IsNameValidationVisible}"
                           TextColor="Red"
                           FontSize="12" />

                    <Grid Grid.Row="3"
                          ColumnDefinitions="*,Auto,Auto"
                          ColumnSpacing="12">
                        <Button Grid.Column="1"
                                Text="Cancel"
                                Command="{Binding CancelEditCommand}" />
                        <Button Grid.Column="2"
                                Text="Confirm"
                                Command="{Binding ConfirmEditCommand}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentView>
