<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ICSGameLauncher.App.Views.Components.TitleCardView"
             x:Name="RootCard">

    <Border Stroke="Gray"
            StrokeThickness="1"
            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}"
            Padding="0">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12" />
        </Border.StrokeShape>

        <Grid RowDefinitions="Auto, *, Auto, Auto" RowSpacing="10" Padding="10">

            <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                <Label Grid.Column="0" Text="{Binding TitleName, Source={x:Reference RootCard}}" FontSize="18"
                       FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />

                <Border Grid.Column="1" WidthRequest="30" HeightRequest="30" StrokeShape="RoundRectangle 15"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" BackgroundColor="Transparent">
                    <Label Text="{Binding AgeRating, Source={x:Reference RootCard}}" FontSize="10"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>

            <Border Grid.Row="1" Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" StrokeThickness="1" HeightRequest="120" WidthRequest="120"
                    HorizontalOptions="Center" VerticalOptions="Center">
            </Border>

            <Grid Grid.Row="2" MinimumHeightRequest="40">

                <Button Text="Play" Command="{Binding PlayCommand, Source={x:Reference RootCard}}"
                        BackgroundColor="#5A32FA" CornerRadius="8" WidthRequest="100" HorizontalOptions="Center">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsInStore, Source={x:Reference RootCard}}"
                                     Value="True">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Label Text="{Binding Description, Source={x:Reference RootCard}}" FontSize="12"
                       LineBreakMode="TailTruncation" MaxLines="2" IsVisible="False" VerticalOptions="Center">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding IsInStore, Source={x:Reference RootCard}}"
                                     Value="True">
                            <Setter Property="IsVisible" Value="True" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Grid>

            <Grid Grid.Row="3" ColumnDefinitions="*, *">

                <Button Grid.Column="0" Text="Details" Command="{Binding DetailsCommand, Source={x:Reference RootCard}}" CommandParameter="{Binding .}" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" BorderColor="Black" BorderWidth="1" CornerRadius="8" Margin="0,0,5,0" />

                <Button Grid.Column="1" Text="Remove" Command="{Binding RemoveCommand, Source={x:Reference RootCard}}" CommandParameter="{Binding .}" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" BorderColor="Black" BorderWidth="1" CornerRadius="8" Margin="5,0,0,0">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsInStore, Source={x:Reference RootCard}}" Value="True">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Button Grid.Column="1" Text="Add to" Command="{Binding AddToCommand, Source={x:Reference RootCard}}" CommandParameter="{Binding .}" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" BorderColor="Black" BorderWidth="1" CornerRadius="8" Margin="5,0,0,0" IsVisible="False">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsInStore, Source={x:Reference RootCard}}" Value="True">
                            <Setter Property="IsVisible" Value="True" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

            </Grid>

        </Grid>
    </Border>
</ContentView>