<?xml version="1.0" encoding="utf-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:ICSGameLauncher.App.ViewModels"
             xmlns:dto="clr-namespace:ICSGameLauncher.BL.DTO"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="viewModels:AddGamePopupViewModel"
             x:Class="ICSGameLauncher.App.Views.AddGamePopupView">

    <Border StrokeShape="RoundRectangle 15"
            Padding="15"
            BackgroundColor="{AppThemeBinding Light=White, Dark=#222222}"
            VerticalOptions="Center"
            HorizontalOptions="Center">
        <ScrollView>
                    <VerticalStackLayout>
            <Border BackgroundColor="#FFD2D2"
                    Stroke="#FF0000"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="10"
                    Margin="0,0,0,20"
                    IsVisible="{Binding ErrorVisible}"
                    HorizontalOptions="Fill">
                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                    <Label Text="⚠" TextColor="#B00020" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Label Text="Invalid input. Please check the fields and try again."
                           TextColor="#B00020"
                           VerticalOptions="Center"
                           FontSize="14" />
                </HorizontalStackLayout>
            </Border>
            <Grid VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="700">
                <VerticalStackLayout Spacing="25">

                    <Label Text="Add new game"
                           IsVisible="{Binding AddingNew}"
                           Style="{StaticResource SubHeadline}"
                           HorizontalOptions="Start" />

                    <Label Text="Edit game"
                           IsVisible="{Binding AddingNew, Converter={toolkit:InvertedBoolConverter}}"
                           Style="{StaticResource SubHeadline}"
                           HorizontalOptions="Start" />

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="20">

                        <VerticalStackLayout Grid.Column="0" Spacing="20">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Game Title" FontAttributes="Bold" />
                                <Border StrokeShape="RoundRectangle 8"
                                        StrokeThickness="1">
                                    <Entry Placeholder="Enter game title..."
                                           Text="{Binding GameTitle}"
                                           Margin="10,0" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="8">
                                <Label Text="Description" FontAttributes="Bold" />
                                <Border StrokeShape="RoundRectangle 8"
                                        StrokeThickness="1">
                                    <Editor Placeholder="Enter game description..."
                                            HeightRequest="100"
                                            Text="{Binding GameDescription}"
                                            Margin="10,0" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*, Auto" VerticalOptions="End">
                                    <Label Grid.Column="0" Text="Studio" FontAttributes="Bold" VerticalOptions="Center" />

                                    <Button Grid.Column="1"
                                            Text="+"
                                            WidthRequest="24"
                                            HeightRequest="24"
                                            MinimumHeightRequest="0"
                                            MinimumWidthRequest="0"
                                            CornerRadius="12"
                                            Padding="0"
                                            Margin="0"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            Command="{Binding CreateStudioCommand}"
                                            VerticalOptions="Center" />
                                </Grid>

                                <Border StrokeShape="RoundRectangle 8"
                                        StrokeThickness="1">
                                    <Picker Title="Select studio..."
                                            ItemsSource="{Binding Studios}"
                                            SelectedItem="{Binding SelectedStudio}"
                                            ItemDisplayBinding="{Binding Name, x:DataType=dto:StudioDto}"
                                            Margin="10,0" />
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="20">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*, Auto" VerticalOptions="End">
                                    <Label Grid.Column="0" Text="Categories" FontAttributes="Bold" VerticalOptions="Center" />

                                    <Button Grid.Column="1"
                                            Text="+"
                                            WidthRequest="24"
                                            HeightRequest="24"
                                            MinimumHeightRequest="0"
                                            MinimumWidthRequest="0"
                                            CornerRadius="12"
                                            Padding="0"
                                            Margin="0"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            Command="{Binding CreateCategoryCommand}"
                                            VerticalOptions="Center" />
                                </Grid>

                                <Border StrokeShape="RoundRectangle 8"
                                        StrokeThickness="1">
                                     <ScrollView Margin="5" Orientation="Vertical" HeightRequest="188">
                                         <VerticalStackLayout BindableLayout.ItemsSource="{Binding Categories}"
                                                              Spacing="5">
                                             <BindableLayout.ItemTemplate>
                                                 <DataTemplate x:DataType="viewModels:SelectableCategoryViewModel">
                                                     <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                                         <CheckBox IsChecked="{Binding IsSelected}" />
                                                         <Label Text="{Binding Category.Name}"
                                                                VerticalOptions="Center" />
                                                     </HorizontalStackLayout>
                                                 </DataTemplate>
                                             </BindableLayout.ItemTemplate>
                                         </VerticalStackLayout>
                                    </ScrollView>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="8">
                                <Label Text="PEGI Rating" FontAttributes="Bold" />
                                <Border StrokeShape="RoundRectangle 8"
                                        StrokeThickness="1">
                                    <Picker Title="Select PEGI rating..."
                                            ItemsSource="{Binding PegiRatings}"
                                            SelectedItem="{Binding SelectedPegiRating}"
                                            Margin="10,0" />
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                    </Grid>

                    <HorizontalStackLayout Spacing="15" HorizontalOptions="End" Margin="0,10,0,0">
                        <Button Text="Cancel"
                                Command="{Binding CancelCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                BorderColor="Gray"
                                BorderWidth="1"
                                WidthRequest="100"/>

                        <Button Text="Save"
                                Command="{Binding SaveCommand}"
                                WidthRequest="120" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Grid>
        </VerticalStackLayout>
        </ScrollView>
    </Border>

</ContentView>