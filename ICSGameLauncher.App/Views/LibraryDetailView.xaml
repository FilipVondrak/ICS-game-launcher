<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ICSGameLauncher.App.ViewModels"
             xmlns:dto="clr-namespace:ICSGameLauncher.BL.DTO;assembly=ICSGameLauncher.BL"
             xmlns:converters="clr-namespace:ICSGameLauncher.App.Converters"
             xmlns:components="clr-namespace:ICSGameLauncher.App.Views.Components"
             xmlns:views="clr-namespace:ICSGameLauncher.App.Views"
             x:Class="ICSGameLauncher.App.Views.LibraryDetailView"
             x:DataType="vm:LibraryDetailViewModel"
             x:Name="RootView">

    <ContentView.Resources>
        <converters:PegiToAgeConverter x:Key="PegiConverter" />
    </ContentView.Resources>

    <Grid>

        <Grid RowDefinitions="Auto, Auto, Auto, *" Padding="15" RowSpacing="10">

            <Grid Grid.Row="0" ColumnDefinitions="*,*,*">

                <HorizontalStackLayout Grid.Column="2"
                                       Spacing="8"
                                       Margin="24,0,0,0"
                                       HorizontalOptions="Start"
                                       VerticalOptions="Start">
                    <Button Text="&#9776;"
                            WidthRequest="56"
                            HeightRequest="48"
                            CornerRadius="8"
                            Command="{Binding ToggleFilterPopupCommand}"
                            CommandParameter="{Binding BindingContext, Source={x:Reference FilterPopup}}" />
                    <Button x:Name="SortButton"
                            Text="&#8645;"
                            WidthRequest="56"
                            HeightRequest="48"
                            CornerRadius="8"
                            Command="{Binding ToggleSortPopupCommand}" />

                </HorizontalStackLayout>
            </Grid>

            <HorizontalStackLayout Grid.Row="1" HorizontalOptions="Center" Spacing="20" Margin="0,0,0,0">
                <Label Text="{Binding Library.Description}" FontSize="32" FontAttributes="Bold" VerticalOptions="Center"/>
                <Border WidthRequest="45" HeightRequest="45" StrokeShape="RoundRectangle 15"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" BackgroundColor="Transparent">
                <Button Text="Edit" FontSize="13" Padding="0" HeightRequest="40" WidthRequest="40" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" VerticalOptions="Center" Command="{Binding EditLibraryCommand}" />
                </Border>
                <Border WidthRequest="85" HeightRequest="45" StrokeShape="RoundRectangle 15"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" BackgroundColor="Transparent">
                <Button Text="Delete" FontSize="13" Padding="0" HeightRequest="40" WidthRequest="80" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" VerticalOptions="Center" Command="{Binding DeleteLibraryCommand}" />
                </Border>
            </HorizontalStackLayout>

            <Label Grid.Row="2" Text="{Binding Library.TitleCount, StringFormat='{0} titles'}" FontSize="18" TextColor="Gray" HorizontalOptions="Center" Margin="0,0,0,20"/>

            <ScrollView Grid.Row="3" VerticalOptions="Fill">

                <FlexLayout BindableLayout.ItemsSource="{Binding Titles}"
                            Wrap="Wrap"
                            Direction="Row"
                            JustifyContent="Start"
                            AlignItems="Start">

                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="dto:TitleDto">
                            <ContentView WidthRequest="220" HeightRequest="350" Margin="10">
                                <components:TitleCardView
                                    TitleName="{Binding Name}"
                                    AgeRating="{Binding PegiRating, Converter={StaticResource PegiConverter}}"
                                    IsInStore="False"
                                    PlayCommand="{Binding BindingContext.PlayGameCommand, Source={x:Reference RootView}}"
                                    DetailsCommand="{Binding BindingContext.ShowGameDetailsCommand, Source={x:Reference RootView}}"
                                    RemoveCommand="{Binding BindingContext.RemoveGameCommand, Source={x:Reference RootView}}" />
                            </ContentView>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>

                </FlexLayout>

            </ScrollView>

        </Grid>

        <Grid IsVisible="{Binding IsEditPopupVisible}"
              InputTransparent="False">
            <Border HorizontalOptions="Fill"
                    VerticalOptions="Start"
                    Margin="20,120,20,0"
                    MaximumWidthRequest="720"
                    Padding="16"
                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

                <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                      RowSpacing="14">
                    <Label Grid.Row="0"
                           Text="Edit Library"
                           FontSize="22"
                           HorizontalOptions="Center" />

                    <Grid Grid.Row="1"
                          ColumnDefinitions="Auto,*"
                          ColumnSpacing="12">
                        <Label Grid.Column="0"
                               Text="Library Name:"
                               VerticalOptions="Center" />
                        <Entry Grid.Column="1"
                               Text="{Binding EditedLibraryName}" />
                    </Grid>

                    <Label Grid.Row="2"
                           Text="Library name is required!"
                           IsVisible="{Binding IsNameValidationVisible}"
                           TextColor="Red"
                           FontSize="12" />

                    <Grid Grid.Row="3"
                          ColumnDefinitions="*,Auto,Auto"
                          ColumnSpacing="12">
                        <Button Grid.Column="1"
                                Text="Cancel"
                                Command="{Binding CancelEditCommand}" />
                        <Button Grid.Column="2"
                                Text="Confirm"
                                Command="{Binding ConfirmEditCommand}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid InputTransparent="True"
              CascadeInputTransparent="False"
              ZIndex="100"
              Padding="30">

            <Border x:Name="SortPopup"
                    IsVisible="{Binding IsSortPopupVisible}"
                    InputTransparent="False"
                    Margin="0,52,120,0"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    WidthRequest="320"
                    MaximumWidthRequest="340"
                    Padding="12"
                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10" Padding="0,0,0,8">
                    <Label Text="Sort by:" FontSize="22" HorizontalOptions="Center" />

                    <VerticalStackLayout Spacing="4">
                        <HorizontalStackLayout Spacing="0">
                            <CheckBox x:Name="SortByNameCheckBox" IsChecked="{Binding SortByName}" />
                            <Label Text="Name" VerticalOptions="Center" Margin="-6,0,0,0" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="0">
                            <CheckBox x:Name="SortByStudioCheckBox" IsChecked="{Binding SortByStudio}" />
                            <Label Text="Studio" VerticalOptions="Center" Margin="-6,0,0,0" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="0">
                            <CheckBox x:Name="SortByPegiCheckBox" IsChecked="{Binding SortByPegi}" />
                            <Label Text="PEGI rating" VerticalOptions="Center" Margin="-6,0,0,0" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="0">
                            <CheckBox x:Name="SortByCategoryCheckBox" IsChecked="{Binding SortByCategory}" />
                            <Label Text="Category" VerticalOptions="Center" Margin="-6,0,0,0" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Margin="0,6,0,0" />
                    <Label Text="Direction:" FontSize="18" HorizontalOptions="Center" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Text="Ascending (A-Z)"
                                Opacity="{Binding SortAscendingOpacity}"
                                Command="{Binding SetSortDirectionCommand}" CommandParameter="{x:Boolean True}" />
                        <Button Grid.Column="1" Text="Descending (Z-A)"
                                Opacity="{Binding SortDescendingOpacity}"
                                Command="{Binding SetSortDirectionCommand}" CommandParameter="{x:Boolean False}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <views:FilterPopupView x:Name="FilterPopup"
                                   IsVisible="{Binding BindingContext.IsFilterPopupVisible, Source={x:Reference RootView}}"
                                   InputTransparent="False"
                                   Margin="0, 52, 64, 0"
                                   HorizontalOptions="End"
                                   VerticalOptions="Start" />
        </Grid>
    </Grid>
</ContentView>