<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:ICSGameLauncher.App.ViewModels"
             x:DataType="viewmodels:LoginViewModel"
             x:Class="ICSGameLauncher.App.Views.LoginPage">
    <ContentPage.Content>
        <Grid ColumnDefinitions="*, Auto, *" RowDefinitions="*, Auto, *" Padding="20">
            <Button Grid.Column="1" Grid.Row="1" Text="Log in" Command="{Binding LoginCommand}"/>
        </Grid>
    </ContentPage.Content>
</ContentPage>